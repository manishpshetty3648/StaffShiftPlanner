{
  "name": "staffshiftplanner",
  "version": "1.0.0",
  "description": "StaffShift Fairness - Staff rota planner with availability, inconvenient shift balance, overlap detection, and coverage analysis",
  "main": "backend/server.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "npm run test --prefix backend"
  },
  "keywords": [
    "shift-planner",
    "fairness",
    "rota",
    "mongodb",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
